{
  "displayName": "Fraeno could not dispatch a validation",
  "documentation": {
    "content": "Fraeno could not start the trusted repository workflow. Check repository readiness, permissions, and GitHub availability.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "A workflow dispatch failed",
      "conditionMatchedLog": {
        "filter": "resource.type=\"cloud_run_revision\" AND jsonPayload.fraeno_metric=\"dispatch_failure\""
      }
    }
  ],
  "combiner": "OR",
  "enabled": false,
  "alertStrategy": {
    "notificationRateLimit": {
      "period": "1800s"
    },
    "autoClose": "86400s"
  },
  "notificationChannels": []
}
