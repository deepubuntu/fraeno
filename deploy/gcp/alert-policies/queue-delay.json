{
  "displayName": "Fraeno queue delay is high",
  "documentation": {
    "content": "A GitHub event waited at least two minutes before the worker started it. Check Cloud Tasks backlog and worker capacity.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "Queue delay reached two minutes",
      "conditionMatchedLog": {
        "filter": "resource.type=\"cloud_run_revision\" AND jsonPayload.fraeno_metric=\"queue_delay_seconds\" AND jsonPayload.value>=120"
      }
    }
  ],
  "combiner": "OR",
  "enabled": false,
  "alertStrategy": {
    "notificationRateLimit": {
      "period": "1800s"
    },
    "autoClose": "86400s"
  },
  "notificationChannels": []
}
