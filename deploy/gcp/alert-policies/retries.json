{
  "displayName": "Fraeno delivery reached repeated retries",
  "documentation": {
    "content": "A delivery reached its third Cloud Tasks retry. Inspect the delivery metadata before it reaches the dead-letter state.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "Delivery reached retry three",
      "conditionMatchedLog": {
        "filter": "resource.type=\"cloud_run_revision\" AND jsonPayload.fraeno_metric=\"delivery_retry\" AND jsonPayload.value>=3"
      }
    }
  ],
  "combiner": "OR",
  "enabled": false,
  "alertStrategy": {
    "notificationRateLimit": {
      "period": "1800s"
    },
    "autoClose": "86400s"
  },
  "notificationChannels": []
}
